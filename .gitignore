# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
build/
dist/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Training data (large, fetched/generated separately) ---
datasets/

# --- Model weights / exported artifacts (large binaries) ---
weights/*
*.pt
*.pth
*.onnx
*.engine
*.torchscript

# Keep the two deployed checkpoints so a fresh clone can actually run the model
!weights/best.pt
!weights/drone_best.pt

# Deployed TensorRT engines. NOTE: these are serialized against a specific GPU
# architecture + TensorRT/CUDA version and will NOT deserialize on other hosts.
# Rebuild from the .pt checkpoints if loading fails.
!detector/weights/best.engine
!detector/weights/drone_best.engine

# --- Generated runs / logs / benchmark output ---
runs/
logs/
*.log

# --- Video / media (large, generated or captured footage) ---
*.mp4
*.avi
*.mov
*.mkv

# --- Plain-text scratch/report files (keep requirements.txt only) ---
*.txt
!requirements.txt

# --- Claude Code related ---
.claude/
CLAUDE.md
.claude.json
.mcp.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
