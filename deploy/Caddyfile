# Single public origin in front of the split stack. Routes each path to the
# right service so phones/operators only ever see one HTTPS URL. Caddy upgrades
# WebSockets transparently.
#
# Upstreams are env-driven so this one file serves both deployments:
#   - all-in-one (one laptop): defaults resolve to compose service names.
#   - distributed (3 laptops): the broadcast laptop sets DETECTOR_UPSTREAM /
#     FUSION_UPSTREAM / WEB_UPSTREAM to the other laptops' mesh addresses.
{
	auto_https off
}

:80 {
	# Detector service: inference, the operator VIDEO relay, and the misc APIs.
	@detector path /ws/track* /ws/view* /webrtc/* /detect /detect/* /exclude /exclude/* /train /train/* /health /docs /docs/* /openapi.json
	handle @detector {
		reverse_proxy {$DETECTOR_UPSTREAM:detector:8000}
	}

	# Fusion service: pose in, phone ghosts, operator detection overlays, map.
	@fusion path /ws/pose* /ws/ghosts* /ws/detections* /fusion/*
	handle @fusion {
		reverse_proxy {$FUSION_UPSTREAM:fusion:8100}
	}

	# Everything else is the Next.js web client.
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}
