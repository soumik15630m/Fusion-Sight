# Copy to .env and set the fusion laptop's address (Tailscale MagicDNS name or
# tailnet IP). The default assumes you named the fusion machine "fusion".
FUSION_WS_URL=ws://fusion:8100/ws/ingest

# Optional: bind the published port to a specific interface (e.g. the tailnet IP)
# instead of all interfaces, so the detector is reachable only over the mesh.
# BIND_ADDR=100.x.y.z
